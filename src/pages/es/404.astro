---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFoundImage from '@src/assets/img/404-not-found.png';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout title={`404 - ${t('404.title')}`} description={t('404.description')}>
	<div class='container text-center'>
		<Image width={300} class='my-8 mx-auto' src={NotFoundImage} alt='404' />
		<div class='p-4'>
			<h1 class='text-5xl font-bold my-4'>{t('404.title')}</h1>
			<p class='text-xl'>{t('404.description')}</p>
			<a
				href='/es/'
				class='inline-block mt-6 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-md transition-colors'
			>
				{t('404.back')}
			</a>
		</div>
	</div>
</BaseLayout>
