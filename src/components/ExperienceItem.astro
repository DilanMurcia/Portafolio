---
import type { Experience } from '../data/cv';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
	experience: Experience;
}

const { experience } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const role = experience.role[lang] || experience.role.es;
const date = experience.date[lang] || experience.date.es;
---

<article class='border-l-4 border-blue-500 pl-4 py-2 mb-4'>
	<header class='mb-1'>
		<h3 class='text-xl font-semibold text-zinc-900 dark:text-zinc-100'>
			{role}
		</h3>
		<p class='text-zinc-600 dark:text-zinc-400'>
			<span class='font-medium'>{experience.company}</span>
			· {experience.location}
		</p>
		<p class='text-sm text-zinc-500 dark:text-zinc-500'>{date}</p>
	</header>
	<ul class='list-disc pl-5 mt-2 space-y-1'>
		{
			experience.description[lang].map((line) => (
				<li class='text-zinc-700 dark:text-zinc-300'>{line}</li>
			))
		}
	</ul>
</article>
