---
import { SITE } from '../../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Dilan from '@src/assets/img/logo.jpg';
import Prose from '../../components/Prose.astro';
import { projects } from '../../data/projects';
import ProjectList from '../../components/ProjectList.astro';
import PostItem from '../../components/PostItem.astro';
import { useTranslations } from '../../i18n/utils';

type BlogPost = CollectionEntry<'blog'>;

const lang = 'es';
const t = useTranslations(lang);
const top6Projects = projects.slice(0, 6);
const posts = (await getCollection('blog', ({ data }) => data.locale === lang))
	.sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const site = SITE.es;
---

<BaseLayout
	title={`${site.title} - ${site.tagline}`}
	description={site.description}
>
	<div class='container'>
		<div class='w-full md:flex md:items-center gap-16 mb-10'>
			<div class='text-pretty leading-9'>
				<h1 class='text-4xl font-bold mb-4'>
					{t('home.greeting')} {t('home.greeting.hand')}, {t('home.greeting.name')}
				</h1>
				<Prose>
					<div class='text-lg'>
						<p>
							{t('home.intro.lead')} <strong>{t('home.intro.role')}</strong> {t('home.intro.tail')}
						</p>
						<p>{t('home.intro.body')}</p>
						<p>{t('home.intro.cta')}</p>
					</div>
				</Prose>
			</div>
			<Image
				src={Dilan}
				alt='Dilan Albert Murcia Parra'
				width={300}
				loading='eager'
				class='rounded-3xl rotate-3 mx-4 md:mx-0'
			/>
		</div>
		<main>
			<div class='mt-6 mb-12'>
				<div class='flex justify-between gap-2 border-b mb-1 dark:border-b-zinc-700'>
					<h2 class='text-lg font-bold mb-3'>{t('home.section.services')}</h2>
					<a href='/es/servicios/' class='inline-block py-2 underline dark:prose-invert'>
						{t('home.section.services.link')}
					</a>
				</div>
				<div>
					{posts.map((post: BlogPost) => <PostItem post={post} />)}
				</div>
				<div class='text-right'></div>
			</div>
			<div>
				<div class='flex justify-between gap-2 mb-1'>
					<h2 class='text-lg font-bold mb-3'>{t('home.section.projects')}</h2>
					<a href='/es/projects/' class='inline-block py-2 underline dark:prose-invert'>
						{t('home.section.projects.link')}
					</a>
				</div>
				<ProjectList projects={top6Projects} />
			</div>
		</main>
	</div>
</BaseLayout>
