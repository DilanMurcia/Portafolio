---
interface Props {
	items: string[];
}

const { items } = Astro.props;
---

<div class='flex flex-wrap gap-2'>
	{
		items.map((item) => (
			<span class='inline-block bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-200 text-sm font-medium px-3 py-1 rounded-full'>
				{item}
			</span>
		))
	}
</div>
