---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { slugify, unslugify } from '../../../utils';
import PostsByYear from '../../../components/PostsByYear.astro';
import { useTranslations } from '../../../i18n/utils';

type BlogPost = CollectionEntry<'blog'>;

export const getStaticPaths = async () => {
	const allPosts: BlogPost[] = await getCollection('blog', ({ data }) => data.locale === 'es');
	return [
		...new Set(
			allPosts
				.map((post) => post.data.tags)
				.flat()
				.filter((tag) => !!tag)
		)
	].map((tag) => ({ params: { tag: slugify(tag || '') } }));
};

const { tag } = Astro.params;
const allPosts: BlogPost[] = (await getCollection('blog', ({ data }) => data.locale === 'es')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const taggedPosts = allPosts.filter((post) =>
	post.data.tags?.map((t) => slugify(t)).includes(tag || '')
);
const tagLabel = unslugify(tag || '');
const title = `Publicaciones etiquetadas con ${tagLabel}`;
const description = `Todas las publicaciones etiquetadas con ${tagLabel}`;
---

<BaseLayout title={title} description={description}>
	<div class='container'>
		<div class='mb-10'>
			<h1 class='text-3xl font-bold mb-2'>{title}</h1>
		</div>
		<PostsByYear posts={taggedPosts} />
	</div>
</BaseLayout>
