---
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const today = new Date();
---

<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css' />

<footer class='container mt-8'>
	<div class='justify-center flex gap-4 py-8 prose dark:prose-invert text-sm'>
		<a
			href='https://github.com/DilanMurcia'
			target='_blank'
			rel='noopener noreferrer'
			class='text-black hover:text-gray-500 transition-colors dark:text-white hover:dark:text-gray-400'
			aria-label='GitHub'
		>
			<i class='fab fa-github fa-2x'></i>
		</a>
		<a
			href='https://x.com/Dilan_Murcia_'
			target='_blank'
			rel='noopener noreferrer'
			class='text-black hover:text-gray-500 transition-colors dark:text-white hover:dark:text-gray-400'
			aria-label='Twitter'
		>
			<i class='fab fa-twitter fa-2x'></i>
		</a>
		<a
			href='https://wa.me/+573216903828'
			target='_blank'
			rel='noopener noreferrer'
			class='text-black hover:text-gray-500 transition-colors dark:text-white hover:dark:text-gray-400'
			aria-label='WhatsApp'
		>
			<i class='fab fa-whatsapp fa-2x'></i>
		</a>
		<a
			href='https://mail.google.com/mail/?view=cm&fs=1&to=dapdesarrollador@gmail.com'
			class='text-black hover:text-gray-500 transition-colors dark:text-white hover:dark:text-gray-400'
			aria-label='Email'
		>
			<i class='fas fa-envelope fa-2x'></i>
		</a>
	</div>
</footer>
<div class='py-4 border-t dark:border-t-zinc-700'>
	<div class='text-center text-sm text-zinc-500 dark:text-zinc-400 py-4'>
		© {today.getFullYear()} Dilan Albert Murcia Parra
	</div>
</div>
